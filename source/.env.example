# Interface (publique par conception : la clé « anon » est protégée par la RLS, jamais par le secret).
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique
# Connexion par SMS : laisser « false » tant qu'un fournisseur de SMS n'est pas configuré dans Supabase (docs/SETUP.md).
VITE_ENABLE_PHONE_LOGIN=false

# NE JAMAIS mettre ici : la clé service_role, la clé Resend, la clé IA. Elles se configurent en SECRETS Supabase
# (voir docs/SETUP.md) :  supabase secrets set CRON_SECRET=... RESEND_API_KEY=... EMAIL_FROM=... APP_URL=... ALLOWED_ORIGINS=...
